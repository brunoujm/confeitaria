# Dockerfile for Socket.io Server with ffprobe
# Build: docker build -f Dockerfile.socket -t confeitaria-socket .
# Run: docker run -p 3001:3001 --env-file .env confeitaria-socket

FROM node:20-alpine AS base

# Install ffmpeg (includes ffprobe) for video validation
RUN apk add --no-cache ffmpeg

# Verify ffprobe is available
RUN ffprobe -version

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy socket server source
COPY src/app/api/socket ./src/app/api/socket
COPY src/lib ./src/lib
COPY src/types ./src/types

# Expose socket port
EXPOSE 3001

# Start socket server
CMD ["node", "src/app/api/socket/server.js"]