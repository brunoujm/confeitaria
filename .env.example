# Database (Turso/libSQL)
DATABASE_URL="libsql://your-database.turso.io"
DATABASE_AUTH_TOKEN="your-auth-token"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="media"

# AI Providers (at least one required in production)
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Upstash Redis (Rate Limiting) - Required in production for fail-closed rate limiting
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Socket.io
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_SECRET="your-socket-secret"

# Cron Jobs (required for cleanup cron in production)
CRON_SECRET="your-cron-secret-min-32-chars"

# Sentry (optional - for error monitoring in production)
# SENTRY_DSN="https://xxx@sentry.io/xxx"
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx"
# APP_VERSION="0.1.0"
# NEXT_PUBLIC_APP_VERSION="0.1.0"