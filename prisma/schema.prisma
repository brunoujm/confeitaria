// prisma/schema.prisma - Confeitaria Content Manager

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  password          String    @map("passwordHash")
  role              String    @default("OWNER")
  emailNotifications Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  posts             Post[]
  notifications     Notification[]
  brandIdentities   BrandIdentity[]
  aiPresets         AIPreset[]
  templates         Template[]
  aiConfig          AIConfig?
}

model Post {
  id          String     @id @default(cuid())
  title       String
  caption     String?
  hashtags    String     // JSON array stored as string
  type        String     // FEED, STORIES, REELS, WHATSAPP_STATUS, WHATSAPP_CATALOG
  status      String     @default("DRAFT") // DRAFT, APPROVED, PUBLISHED, ARCHIVED
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  media       Media[]
  templateId  String?
  template    Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([authorId, status])           // Dashboard: filter posts by author + status
  @@index([authorId, status, scheduledAt]) // Calendar: filter by author + status + date range + order by scheduledAt
}

model Media {
  id        String    @id @default(cuid())
  url       String
  type      String    // IMAGE, VIDEO
  size      Int
  width     Int?
  height    Int?
  duration  Float?
  createdAt DateTime  @default(now())

  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("outros")
  structure   String   // JSON stored as string: { caption, hashtags, media, type }
  thumbnail   String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  posts       Post[]

  @@index([userId])
  @@index([userId, isPublic]) // Template listing: WHERE (userId = ? OR isPublic = true)
}

model BrandIdentity {
  id              String   @id @default(cuid())
  name            String
  colors          String   // JSON stored as string: { primary, secondary, accent, background, surface, text, textMuted, success, warning, error }
  fonts           String   // JSON stored as string: { heading, body }
  logos           String   // JSON stored as string: { main, dark, watermark }
  defaultHashtags String   // JSON array stored as string
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
}

model AIConfig {
  id              String   @id @default(cuid())
  openaiModel     String   @default("gpt-4o")
  anthropicModel  String   @default("claude-3-5-sonnet-20241022")
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(2000)
  systemPrompt    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIPreset {
  id          String      @id @default(cuid())
  name        String
  description String?
  type        String      // CAPTION, HASHTAG, IMAGE
  prompt      String
  variables   String?     // JSON array stored as string
  model       String
  temperature Float       @default(0.7)
  maxTokens   Int         @default(1000)
  isDefault   Boolean     @default(false)
  isPublic    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId])
  @@index([isDefault])
}

model Notification {
  id        String            @id @default(cuid())
  type      String            // POST_APPROVED, POST_PUBLISHED, POST_COMMENT, MENTION, SYSTEM
  title     String
  message   String
  read      Boolean           @default(false)
  data      String?           // JSON stored as string
  createdAt DateTime          @default(now())

  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@index([userId, read, createdAt]) // Notifications list: WHERE userId = ? AND read = ? ORDER BY createdAt DESC
}